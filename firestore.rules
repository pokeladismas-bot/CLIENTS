rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test document used to verify connection
    match /test/{docId} {
      allow read, write: if true;
    }

    // System synchronization & shared device registry (multi-device sync)
    match /system/{docId} {
      allow read, write: if true;
    }

    // Clinical security & global system settings
    match /settings/{docId} {
      allow read, write: if true;
    }

    // User profiles & credentials
    match /users/{userId} {
      allow read, write: if true;
    }

    // Patients collection
    match /patients/{patientId} {
      allow read, write: if true;
    }

    // Clinic logs and dietary records
    match /logs/{logId} {
      allow read, write: if true;
    }

    // Clinical reports & audit summaries
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Clinical telemetry and health telemetry
    match /records/{recordId} {
      allow read, write: if true;
    }
  }
}

